NODE_ENV=production
HOST=0.0.0.0
PORT=5000
API_PREFIX=/api/v1
TRUST_PROXY=true

STORAGE_PATH=/var/data/pantone/uploads

# Cloud Managed Database (e.g. Supabase, Neon) - overrides DB_HOST/PORT/USER/PASSWORD if set
# DATABASE_URL=postgresql://user:pass@ep-host.region.aws.neon.tech/neondb
DB_HOST=postgres
DB_PORT=5432
DB_USER=pantone_prod_user
DB_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_FOR_PRODUCTION_POSTGRES
DB_NAME=pantone_fam
DB_SSL=false
DB_POOL_MIN=4
DB_POOL_MAX=30

JWT_SECRET=GENERATE_STRONG_RANDOM_JWT_SECRET_MIN_32_CHARACTERS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GENERATE_STRONG_RANDOM_REFRESH_SECRET_MIN_32_CHARACTERS
JWT_REFRESH_EXPIRES_IN=7d

SEED_COMMON_ADMIN_PASSWORD=GENERATE_STRONG_COMMON_ADMIN_PASSWORD_FOR_FIRST_BOOT
SEED_APPARELS_ADMIN_PASSWORD=GENERATE_STRONG_APPARELS_ADMIN_PASSWORD_FOR_FIRST_BOOT
SEED_GARMENTS_ADMIN_PASSWORD=GENERATE_STRONG_GARMENTS_ADMIN_PASSWORD_FOR_FIRST_BOOT

CORS_ORIGIN=https://fam.pantone.com
