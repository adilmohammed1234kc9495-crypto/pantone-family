# ==============================================================================
# PANTONE FIXED ASSET MANAGEMENT SYSTEM - BACKEND ENVIRONMENT TEMPLATE
# ==============================================================================

# Application Environment (development | staging | production | test)
NODE_ENV=production
HOST=0.0.0.0
PORT=5000
API_PREFIX=/api/v1
TRUST_PROXY=true

# Persistent File Storage Path
STORAGE_PATH=/var/data/pantone/uploads

# PostgreSQL Private Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=pantone_app_user
DB_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_DATABASE_PASSWORD
DB_NAME=pantone_fam
DB_SSL=false
DB_POOL_MIN=4
DB_POOL_MAX=25

# JWT Authentication (Cryptographically strong secrets: min 32 chars)
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_ACCESS_TOKEN_SECRET_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_REFRESH_TOKEN_SECRET_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# Initial Setup Admin Passwords (used ONLY during first initial deployment seed)
SEED_COMMON_ADMIN_PASSWORD=REPLACE_WITH_STRONG_INITIAL_COMMON_ADMIN_PASSWORD
SEED_APPARELS_ADMIN_PASSWORD=REPLACE_WITH_STRONG_INITIAL_APPARELS_ADMIN_PASSWORD
SEED_GARMENTS_ADMIN_PASSWORD=REPLACE_WITH_STRONG_INITIAL_GARMENTS_ADMIN_PASSWORD

# Cross-Origin Resource Sharing (CORS)
# Production: Specify the exact frontend domain(s) separated by commas. Never '*' in production.
CORS_ORIGIN=https://fam.pantone.com
